# =============================================
# DeepAudit 生产环境配置模板
# 使用: cp .env.prod.example .env.prod
#       vim .env.prod   # 修改所有 CHANGE_ME 项
# =============================================

# ─── 域名配置 ────────────────────────────────
# 你的域名（申请 SSL 证书时使用）
DOMAIN=deepaudit.example.com

# ─── 数据库配置 ──────────────────────────────
DB_USER=deepaudit
# 强密码：建议用 openssl rand -hex 16 生成
DB_PASSWORD=CHANGE_ME_db_password
DB_NAME=deepaudit

# ─── Redis 配置 ───────────────────────────────
# 强密码：建议用 openssl rand -hex 16 生成
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── JWT 密钥 ─────────────────────────────────
# 必须修改！用于签发登录 Token
# 生成命令: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_jwt_secret_key_min_32_chars

# ─── LLM 配置 ─────────────────────────────────
# 支持: openai / azure / anthropic / deepseek / qwen / ollama 等
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here
# 如使用国内或第三方中转地址，填写此项
LLM_BASE_URL=

# ─── 镜像配置 ─────────────────────────────────
# 国内加速（可选，使用南京大学镜像站）
# BACKEND_IMAGE=ghcr.nju.edu.cn/lintsinghua/deepaudit-backend:latest
# FRONTEND_IMAGE=ghcr.nju.edu.cn/lintsinghua/deepaudit-frontend:latest
# SANDBOX_IMAGE=ghcr.nju.edu.cn/lintsinghua/deepaudit-sandbox:latest
BACKEND_IMAGE=ghcr.io/lintsinghua/deepaudit-backend:latest
FRONTEND_IMAGE=ghcr.io/lintsinghua/deepaudit-frontend:latest
SANDBOX_IMAGE=ghcr.io/lintsinghua/deepaudit-sandbox:latest

# ─── 功能开关 ─────────────────────────────────
SANDBOX_ENABLED=true
AGENT_ENABLED=true
